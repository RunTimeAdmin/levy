# Levy static site on Hostinger (LiteSpeed/Apache). If public_html already has
# an .htaccess, add this block to it rather than replacing it.
# Security headers, www to the bare domain, no directory listings, no dotfiles.

Options -Indexes

# Custom error pages
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.getlevy.xyz -> getlevy.xyz
  RewriteCond %{HTTP_HOST} ^www\.getlevy\.xyz$ [NC]
  RewriteRule ^ https://getlevy.xyz%{REQUEST_URI} [R=301,L]
  # Refuse dotfiles and dot-directories, except /.well-known/ (security.txt).
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
</IfModule>

# Enable gzip/deflate compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache lifetimes. File names never change (style.css, not style.3f2a.css), so
# nothing may be cached for long: an edited file must reach returning visitors,
# and Hostinger's CDN may keep them as long. HTML and XML for an hour,
# everything else (CSS, images, the whitepaper PDF, security.txt) for a day.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  
  # Same lifetimes as above, without "immutable" (the files are edited in place).
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|woff|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  
  # HTML pages: allow caching but revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set X-Frame-Options "DENY"
  </FilesMatch>
</IfModule>

# WebP content type
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
