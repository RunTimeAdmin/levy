# Copy to .env and fill in. Never commit a real .env. `npm start` loads it.

# Path to the keeper's SQLite database. The API writes to it too (webhook
# registrations, sign-in challenges and sessions).
LEVY_DB_PATH=../keeper/levy.db

# Port for the API + pages, and the address to listen on.
LEVY_API_PORT=3001
#LEVY_API_HOST=127.0.0.1

# Path of the Ed25519 webhook signing key, for GET /api/webhooks/public-key.
# Must be the keeper's LEVY_WEBHOOK_KEY_PATH. If no file exists here the API
# creates one, and a key that differs from the keeper's makes every merchant's
# signature check fail.
LEVY_WEBHOOK_KEY_PATH=../keeper/webhook-signing-key.pem
# Alternative: the same inline key the keeper uses (PEM PKCS#8 or base64 32-byte seed).
#LEVY_WEBHOOK_KEY=

# Contracts the checkout page and portal use (same values as the keeper's).
LEVY_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
LEVY_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Exact origin the pages are served from. Sign-in messages are bound to it.
LEVY_PUBLIC_ORIGIN=http://localhost:3001
# Chain ID for sign-in messages and for the checkout and portal (served by
# /api/config): 5042 = Arc mainnet, 5042002 = Arc testnet, 31337 = local anvil.
LEVY_CHAIN_ID=5042
# Local development only: accept http and private-address webhook URLs.
#LEVY_WEBHOOK_ALLOW_PRIVATE=1
