# Copy to .env and fill in. Never commit a real .env.

# Path to the keeper's SQLite database. The API is read-mostly; webhook
# registration writes to the same file the keeper uses.
LEVY_DB_PATH=../keeper/levy.db

# Port for the API + dashboards.
LEVY_API_PORT=3001

# Path of the Ed25519 webhook signing key, for GET /api/webhooks/public-key.
# Must match the keeper's LEVY_WEBHOOK_KEY_PATH (the keeper generates it on
# first boot if missing).
LEVY_WEBHOOK_KEY_PATH=../keeper/webhook-signing-key.pem
#LEVY_WEBHOOK_KEY=
