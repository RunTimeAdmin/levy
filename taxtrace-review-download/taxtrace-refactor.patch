--- /dev/null
+++ b/reports/src/sqlite.ts
@@ -0,0 +1,33 @@
+// Minimal node:sqlite binding (mirrors the bot's approach) so the report CLI and the read API can open
+// the indexer database without a native dependency. Shared by db.ts and tenants.ts, which previously
+// each carried an identical copy. Internal: not re-exported from index.ts.
+
+export interface RunResult {
+  changes: number | bigint;
+  lastInsertRowid: number | bigint;
+}
+export interface Stmt {
+  run(...params: unknown[]): RunResult;
+  get(...params: unknown[]): unknown;
+  all(...params: unknown[]): unknown[];
+}
+export interface RawDb {
+  exec(sql: string): void;
+  prepare(sql: string): Stmt;
+  close(): void;
+}
+export type SqliteCtor = new (path: string, options?: unknown) => RawDb;
+
+export function loadSqlite(): SqliteCtor {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const mod = require('node:sqlite') as { DatabaseSync?: SqliteCtor };
+    if (!mod || typeof mod.DatabaseSync !== 'function') throw new Error('DatabaseSync missing');
+    return mod.DatabaseSync;
+  } catch (err) {
+    throw new Error(
+      'Failed to load node:sqlite. Run Node with `--experimental-sqlite`. Original: ' +
+        (err instanceof Error ? err.message : String(err))
+    );
+  }
+}
