+/** The wash-sale figures every export derives from a row (previously recomputed in each formatter). */
+export interface WashSaleFigures {
+  /** USD-18 disallowed loss (>= 0); 0n when no wash sale applies. */
+  disallowed: bigint;
+  /** Raw gain/loss plus the disallowed amount: the code-"W" figure Form 8949 column (h) reports. */
+  reportedGainLoss: bigint;
+  /** Form 8949 adjustment code: 'W' when a disallowance applies, else ''. */
+  code: 'W' | '';
+}
+
+export function washSaleFigures(row: Pick<ReportRow, 'gainLoss' | 'washSaleDisallowed'>): WashSaleFigures {
+  const disallowed = BigInt(row.washSaleDisallowed ?? '0');
+  return {
+    disallowed,
+    reportedGainLoss: BigInt(row.gainLoss) + disallowed,
+    code: disallowed > 0n ? 'W' : '',
+  };
+}
