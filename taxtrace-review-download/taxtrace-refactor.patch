diff --git a/reports/test/guardSchemaDrift.test.ts b/reports/test/guardSchemaDrift.test.ts
new file mode 100644
index 0000000..ab07107
--- /dev/null
+++ b/reports/test/guardSchemaDrift.test.ts
@@ -0,0 +1,38 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as fs from 'fs';
+import * as path from 'path';
+import { assertControlPlaneOnly, assertDeclaredBasisOnly } from '../src/index';
+
+// The two control-plane write guards are word-boundary DENYLISTS, so they silently weaken whenever the
+// ledger schema gains a table nobody added to the list (that is how tenant_api_keys, declared_basis,
+// processed_logs, ... slipped through). Pin them to the bot's canonical schema: every table except the
+// one each handle owns must be rejected.
+
+const SCHEMA = path.resolve(__dirname, '../../../bot/src/db/schema.sql');
+
+function schemaTables(): string[] {
+  const sql = fs.readFileSync(SCHEMA, 'utf8');
+  const names = new Set<string>();
+  for (const m of sql.matchAll(/CREATE TABLE (?:IF NOT EXISTS )?([a-z_][a-z0-9_]*)/gi)) {
+    names.add(m[1].toLowerCase());
+  }
+  return [...names].sort();
+}
+
+test('schema.sql is readable and lists the ledger tables', () => {
+  const tables = schemaTables();
+  assert.ok(tables.includes('tax_lots') && tables.includes('wallet_tenant_membership'), SCHEMA);
+});
+
+test('membership guard rejects every ledger table except wallet_tenant_membership', () => {
+  for (const table of schemaTables().filter((t) => t !== 'wallet_tenant_membership')) {
+    assert.throws(() => assertControlPlaneOnly(`DELETE FROM ${table}`), /control-plane-only/, table);
+  }
+});
+
+test('declared-basis guard rejects every ledger table except declared_basis', () => {
+  for (const table of schemaTables().filter((t) => t !== 'declared_basis')) {
+    assert.throws(() => assertDeclaredBasisOnly(`DELETE FROM ${table}`), /control-plane-only/, table);
+  }
+});
