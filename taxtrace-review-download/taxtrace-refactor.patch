diff --git a/reports-api/test/malformedRequest.test.ts b/reports-api/test/malformedRequest.test.ts
new file mode 100644
index 0000000..09cea5c
--- /dev/null
+++ b/reports-api/test/malformedRequest.test.ts
@@ -0,0 +1,46 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as os from 'os';
+import * as fs from 'fs';
+import * as net from 'net';
+import * as path from 'path';
+import type { AddressInfo } from 'node:net';
+import { buildServer } from '../src/server';
+import { loadConfig } from '../src/config';
+
+// Regression: the request URL used to be built from the client's Host header OUTSIDE the handler's
+// try/catch, so one request with a Host that `new URL` rejects threw an unhandled rejection and took
+// the whole process down (pre-auth DoS). It must now be answered and the server must stay up.
+
+function rawRequest(port: number, payload: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    let data = '';
+    const sock = net.connect(port, '127.0.0.1', () => sock.write(payload));
+    // Fail fast instead of hanging: on the unfixed server the request is never answered.
+    sock.setTimeout(3000, () => {
+      sock.destroy();
+      reject(new Error('no response within 3s (handler threw before replying)'));
+    });
+    sock.on('data', (d) => (data += d.toString()));
+    sock.on('end', () => resolve(data));
+    sock.on('error', reject);
+  });
+}
+
+test('a malformed Host header gets a response and does not crash the server', async () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tt-malformed-'));
+  const config = loadConfig({ DB_PATH: path.join(dir, 'ledger.db'), NODE_ENV: 'test' });
+  const { server, close } = buildServer(config);
+  await new Promise<void>((r) => server.listen(0, '127.0.0.1', r));
+  const { port } = server.address() as AddressInfo;
+  try {
+    const bad = await rawRequest(port, 'GET /health HTTP/1.1\r\nHost: bad host\r\nConnection: close\r\n\r\n');
+    assert.match(bad.split('\r\n')[0], /^HTTP\/1\.1 200/, 'path routing must not depend on the Host header');
+
+    const health = await fetch(`http://127.0.0.1:${port}/health`);
+    assert.equal(health.status, 200, 'server must still be serving after the malformed request');
+  } finally {
+    close();
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
