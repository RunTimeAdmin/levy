# Levy production env. Copy to ops/.env and fill in. NEVER commit ops/.env.
# Used by `docker compose -f ops/docker-compose.yml --env-file ops/.env up -d`.
# The systemd path (ops/keeper.service) reads these too via EnvironmentFile.
# Both the keeper and the API read this file, so it holds no secrets: the
# keeper's key goes in ops/keeper.env (ops/keeper.env.example).

# --- chain ---
# RPC endpoint for the chain the contracts live on.
LEVY_RPC_URL=https://rpc.mainnet.arc.io
# Chain ID: 5042 = Arc mainnet, 5042002 = Arc testnet.
LEVY_CHAIN_ID=5042

# --- contracts (fill in from script/Deploy.s.sol's output) ---
LEVY_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
# Arc USDC ERC-20 interface (6 decimals).
LEVY_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- keeper tuning ---
# Milliseconds between charge cycles.
LEVY_POLL_MS=30000
# Dunning: days until the next retry after failure 1, 2, 3+ (default: 1,3,7).
# The contract enforces 1, 3, 7 as the shortest gaps (retryGap): longer values
# are fine, shorter ones gain nothing because a sooner retry reverts RetryTooSoon.
LEVY_DUNNING_DAYS=1,3,7
# Blocks to scan back on first sync (only used when no sync cursor exists).
# To index from the deploy, set it to (current block - deploy block).
LEVY_LOOKBACK_BLOCKS=5000
# Blocks per eth_getLogs request. Arc RPCs cap the range (dRPC rejects 1,000).
LEVY_LOG_CHUNK_BLOCKS=500

# --- webhook signing ---
# The keeper signs webhooks with an Ed25519 key that only it reads (its path
# is in ops/keeper.env) and writes the public half here, which the API serves
# at GET /api/webhooks/public-key so merchants can verify signatures. (In
# Docker this is forced to /data/webhook-public-key.pem.)
LEVY_WEBHOOK_PUBLIC_KEY_PATH=/var/lib/levy/webhook-public-key.pem

# --- api ---
# Port for the API + pages (the host-side port in Docker, bound to 127.0.0.1).
LEVY_API_PORT=3001
# Path to the SQLite DB. In Docker this is forced to /data/levy.db; for the
# systemd keeper, /var/lib/levy/levy.db.
LEVY_DB_PATH=/var/lib/levy/levy.db
# Exact public origin of the pages (required: the API refuses to start
# without it in production). Sign-in messages are bound to it.
LEVY_PUBLIC_ORIGIN=https://app.getlevy.xyz

# --- webhooks (keeper + api) ---
# Milliseconds between webhook delivery passes (separate from charge cycles).
LEVY_WEBHOOK_POLL_MS=5000
# Never set in production: allows http and private-address webhook URLs.
#LEVY_WEBHOOK_ALLOW_PRIVATE=1
