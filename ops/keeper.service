# Levy keeper as a systemd service (bare-VPS alternative to Docker).
#
# Install:
#   1. Copy the repo to /srv/levy (or your preferred path) and update
#      WorkingDirectory below to <path>/keeper.
#   2. cd /srv/levy/keeper && npm ci --omit=dev && npx tsc
#        (builds dist/; the unit runs `node dist/index.js`, no tsx at runtime)
#   3. cp /srv/levy/ops/.env.example /etc/levy/keeper.env && fill in secrets.
#        chmod 600 /etc/levy/keeper.env   (root-owned, levy-readable)
#   4. mkdir -p /var/lib/levy && chown levy:levy /var/lib/levy
#        (SQLite DB + webhook signing key live here; survives redeploys)
#   5. useradd -r -s /usr/sbin/nologin levy   (if not present)
#   6. cp ops/keeper.service /etc/systemd/system/levy-keeper.service
#      systemctl daemon-reload && systemctl enable --now levy-keeper
#
# Logs: journalctl -u levy-keeper -f
# The API can run the same way (port 3001); see api/README or use Docker.

[Unit]
Description=Levy keeper - pull-based USDC subscription charges on Arc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=levy
Group=levy
WorkingDirectory=/srv/levy/keeper
EnvironmentFile=/etc/levy/keeper.env
# DB + signing key on persistent state dir (overrides any .env values).
Environment=LEVY_DB_PATH=/var/lib/levy/levy.db
Environment=LEVY_WEBHOOK_KEY_PATH=/var/lib/levy/webhook-signing-key.pem
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10s
# Backstop: if it crash-loops, stop trying after 5 min of failures.
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging to journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=levy-keeper

# Hardening: needs FS write only under /var/lib/levy and its WorkingDirectory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/levy /srv/levy/keeper
PrivateTmp=true

[Install]
WantedBy=multi-user.target
