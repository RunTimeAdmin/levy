# Levy keeper as a systemd service (bare-VPS alternative to Docker).
# Needs Node 24 at /usr/bin/node (the keeper uses the built-in node:sqlite).
#
# Install:
#   1. Copy the repo to /srv/levy (or your preferred path) and update
#      WorkingDirectory and ReadWritePaths below.
#   2. cd /srv/levy/keeper && npm ci && npx tsc && npm prune --omit=dev
#        (tsc is a dev dependency: build first, then drop dev packages;
#        the unit runs `node dist/index.js`, no tsx at runtime)
#   3. useradd -r -s /usr/sbin/nologin levy   (if not present)
#   4. mkdir -p /var/lib/levy && chown levy:levy /var/lib/levy
#        (SQLite DB, webhook signing key and its public half live here;
#        survives redeploys)
#   5. mkdir -p /etc/levy && cat /srv/levy/ops/.env.example \
#        /srv/levy/ops/keeper.env.example > /etc/levy/keeper.env
#      The first file holds the settings, the second the keeper key and the
#      signing key path (ops/.env.example alone has no LEVY_KEEPER_KEY).
#      Fill both in, then chmod 600 /etc/levy/keeper.env
#        (root-owned is fine: systemd reads it as root before switching user)
#   6. cp ops/keeper.service /etc/systemd/system/levy-keeper.service
#      systemctl daemon-reload && systemctl enable --now levy-keeper
#
# Logs: journalctl -u levy-keeper -f
# The API is not packaged for systemd; run it with Docker (ops/docker-compose.yml)
# against the same DB and the public key the keeper publishes, never the
# signing key. The keeper creates the signing key mode 600 as levy, so run the
# API as a different user (not root, not the host's levy uid): it can then read
# the public key (mode 644) but not the signing key. See docs/wiki/Deployment.md.

[Unit]
Description=Levy keeper - pull-based USDC subscription charges on Arc
After=network-online.target
Wants=network-online.target
# Backstop: after 5 failed starts within 5 minutes, stop restarting.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=levy
Group=levy
WorkingDirectory=/srv/levy/keeper
# Defaults for the persistent state dir. EnvironmentFile wins if keeper.env sets
# the same variables, so keep these paths there too (ops/.env.example and
# ops/keeper.env.example do).
Environment=LEVY_DB_PATH=/var/lib/levy/levy.db
Environment=LEVY_WEBHOOK_KEY_PATH=/var/lib/levy/webhook-signing-key.pem
Environment=LEVY_WEBHOOK_PUBLIC_KEY_PATH=/var/lib/levy/webhook-public-key.pem
EnvironmentFile=/etc/levy/keeper.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10s

# Logging to journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=levy-keeper

# Hardening: needs FS write only under /var/lib/levy and its WorkingDirectory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/levy /srv/levy/keeper
PrivateTmp=true

[Install]
WantedBy=multi-user.target
