# Levy keeper image. Multi-stage: compile TypeScript, ship only dist + prod deps.
FROM node:24-slim AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ ./src/
COPY abi/ ./abi/
RUN npx tsc

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
# State lives on the /data volume (the only path the runtime user can write).
ENV LEVY_DB_PATH=/data/levy.db LEVY_WEBHOOK_KEY_PATH=/keys/webhook-signing-key.pem LEVY_WEBHOOK_PUBLIC_KEY_PATH=/data/webhook-public-key.pem
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /build/dist ./dist
COPY --from=build /build/abi ./abi
# /data holds the SQLite DB and the published public key (shared volume);
# /keys holds the webhook signing key (the keeper's own volume).
# The runtime user owns only /data; the code stays root-owned and read-only
# to it (a recursive chown of /app would also copy every node_modules file
# into a new layer).
RUN mkdir -p /data /keys && useradd -m levy && chown levy:levy /data /keys
USER levy
CMD ["node", "dist/index.js"]
